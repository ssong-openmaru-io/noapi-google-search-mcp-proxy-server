# Playwright가 설치된 Python 이미지를 베이스로 사용합니다.
FROM mcr.microsoft.com/playwright/python:v1.58.0-jammy

# 컨테이너 내 작업 디렉토리를 /app으로 설정합니다.
WORKDIR /app

# pip 패키지 매니저를 최신 버전으로 업그레이드합니다.
RUN pip install --upgrade pip

# Google 검색을 위한 MCP 서버 패키지를 설치합니다.
RUN pip install noapi-google-search-mcp

# Playwright용 Chromium 브라우저를 설치합니다.
RUN playwright install chromium

# Python 로그가 버퍼링 없이 즉시 출력되도록 설정합니다.
ENV PYTHONUNBUFFERED=1

# 보안을 위해 root 대신 기본 제공되는 pwuser 계정을 사용합니다.
USER pwuser

# 컨테이너 시작 시 MCP 서버를 실행합니다.
ENTRYPOINT ["noapi-google-search-mcp"]